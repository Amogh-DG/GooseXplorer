import { ListView } from "std-widgets.slint";

export struct FileItem {
    name: string,
    path: string,
    is-dir: bool,
    size: string,
    description: string,
    tags: [string],
    is-untagged: bool,
}

export struct SidebarItem {
    name: string,
    path: string,
}

export component MainWindow inherits Window {
    in property <string> app-name;
    in property <[FileItem]> files;
    in property <string> current-path;
    in property <string> status-text;
    in-out property <string> active-nav: "Home";
    
    in property <[SidebarItem]> system-folders;
    in property <[SidebarItem]> custom-places;
    in property <[string]> drives;
    
    in-out property <string> selected-file-name;
    in-out property <string> selected-file-path;
    in-out property <string> selected-file-description;
    in-out property <string> selected-file-tags;
    in-out property <string> current-tags;
    in-out property <[string]> selected-file-tags-list;
    in-out property <bool> show-tag-input: false;
    in-out property <bool> show-add-place-input: false;
    in-out property <bool> show-detail: false;
    in-out property <bool> can-go-back: false;
    in-out property <bool> can-go-forward: false;
    in-out property <bool> show-homepage: true;
    in property <string> username: "user";
    in-out property <string> description-suggestion;
    in-out property <string> active-tag-filter: "";
    
    callback sidebar-clicked(string);
    callback file-clicked(string);
    callback folder-clicked(string);
    callback add-tag(string);
    callback save-file(string, string, string);
    callback back-clicked();
    callback forward-clicked();
    callback search-query(string);
    callback file-double-clicked(string);
    callback remove-tag(string);
    callback add-custom-place(string);
    callback remove-custom-place(string);
    callback tag-filter-clicked();
    callback description-edited(string);

    title: app-name;
    width: 1200px;
    height: 800px;
    background: #1a1a1a;
    forward-focus: main-scope;

    main-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == "q" || event.text == "Q") {
                show-detail = false;
                return accept;
            }
            return reject;
        }

        TouchArea {
            pointer-event(event) => {
                if (event.button == PointerEventButton.back && event.kind == PointerEventKind.down) {
                    if (can-go-back) {
                        back-clicked();
                    }
                }
                if (event.button == PointerEventButton.forward && event.kind == PointerEventKind.down) {
                    if (can-go-forward) {
                        forward-clicked();
                    }
                }
            }

            VerticalLayout {
        // 1. Titlebar (32px, #141414, bottom border #2a2a2a)
        Rectangle {
            height: 32px;
            background: #141414;
            
            // Bottom border line
            Rectangle {
                height: 1px;
                y: parent.height - 1px;
                background: #2a2a2a;
            }
            
            // Search button next to control dots
            TouchArea {
                x: 70px;
                width: 65px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                clicked => {
                    show-homepage = true;
                }
                Rectangle {
                    background: parent.has-hover ? #252525 : #1a1a1a;
                    border-color: #333333;
                    border-width: 0.5px;
                    border-radius: 4px;
                    
                    Text {
                        text: "⌕ search";
                        color: #666666;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            
            // Left macOS-style control dots
            HorizontalLayout {
                x: 15px;
                width: 42px; // 3 * 10px + 2 * 6px
                height: 32px;
                spacing: 6px;
                
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle { width: 10px; height: 10px; background: #e24b4a; border-radius: 5px; }
                        Rectangle { width: 10px; height: 10px; background: #ef9f27; border-radius: 5px; }
                        Rectangle { width: 10px; height: 10px; background: #5dcaa5; border-radius: 5px; }
                    }
                }
            }
            
            // Centered App Title
            Text {
                text: app-name;
                color: #666666;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        
        // 2. Main content area (fills remaining space)
        HorizontalLayout {
            // Left Sidebar (200px, #161616, #2a2a2a right border)
            Rectangle {
                width: 200px;
                background: #161616;
                
                // Right border line
                Rectangle {
                    width: 1px;
                    x: parent.width - 1px;
                    background: #2a2a2a;
                }
                
                VerticalLayout {
                    padding: 15px;
                    spacing: 12px;
                    alignment: start;
                    
                    // PLACES Section
                    Text {
                        text: "PLACES";
                        color: #555555;
                        font-size: 10px;
                        font-weight: 700;
                    }
                    
                    for folder in system-folders : TouchArea {
                        clicked => {
                            active-nav = folder.name;
                            sidebar-clicked(folder.path);
                            show-homepage = false;
                        }
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.back && event.kind == PointerEventKind.down) {
                                if (can-go-back) { back-clicked(); }
                            }
                            if (event.button == PointerEventButton.forward && event.kind == PointerEventKind.down) {
                                if (can-go-forward) { forward-clicked(); }
                            }
                        }
                        Rectangle {
                            height: 28px;
                            background: active-nav == folder.name ? #252525 : (parent.has-hover ? #222222 : #161616);
                            border-radius: 5px;
                            
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: start;
                                
                                Text {
                                    text: folder.name;
                                    color: active-nav == folder.name ? #ffffff : #aaaaaa;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    
                    // Custom Places
                    for folder in custom-places : TouchArea {
                        clicked => {
                            active-nav = folder.name;
                            sidebar-clicked(folder.path);
                            show-homepage = false;
                        }
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.back && event.kind == PointerEventKind.down) {
                                if (can-go-back) { back-clicked(); }
                            }
                            if (event.button == PointerEventButton.forward && event.kind == PointerEventKind.down) {
                                if (can-go-forward) { forward-clicked(); }
                            }
                        }
                        Rectangle {
                            height: 28px;
                            background: active-nav == folder.name ? #252525 : (parent.has-hover ? #222222 : #161616);
                            border-radius: 5px;
                            
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                
                                Text {
                                    text: folder.name;
                                    color: active-nav == folder.name ? #ffffff : #aaaaaa;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                
                                TouchArea {
                                    width: 16px;
                                    height: 16px;
                                    clicked => {
                                        remove-custom-place(folder.path);
                                    }
                                    Text {
                                        text: "×";
                                        color: #888888;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    
                    // Add Custom Place Action Button
                    if (!show-add-place-input) : TouchArea {
                        clicked => {
                            show-add-place-input = true;
                        }
                        Rectangle {
                            height: 24px;
                            background: #1e1e1e;
                            border-color: #333333;
                            border-width: 0.5px;
                            border-radius: 5px;
                            
                            Text {
                                text: "+ add folder";
                                color: #aaaaaa;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    
                    if (show-add-place-input) : Rectangle {
                        height: 24px;
                        background: #1e1e1e;
                        border-color: #333333;
                        border-width: 0.5px;
                        border-radius: 5px;
                        
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            
                            TextInput {
                                font-size: 11px;
                                color: #ffffff;
                                vertical-alignment: center;
                                accepted => {
                                    if (self.text != "") {
                                        add-custom-place(self.text);
                                        self.text = "";
                                    }
                                    show-add-place-input = false;
                                }
                                
                                if (self.text == "") : Text {
                                    text: "enter path...";
                                    color: #555555;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    
                    // Spacer between Places and Drives
                    Rectangle { height: 10px; }
                    
                    // DRIVES Section
                    Text {
                        text: "DRIVES";
                        color: #555555;
                        font-size: 10px;
                        font-weight: 700;
                    }
                    
                    for drive in drives : TouchArea {
                        clicked => {
                            active-nav = drive;
                            sidebar-clicked(drive + "\\");
                            show-homepage = false;
                        }
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.back && event.kind == PointerEventKind.down) {
                                if (can-go-back) { back-clicked(); }
                            }
                            if (event.button == PointerEventButton.forward && event.kind == PointerEventKind.down) {
                                if (can-go-forward) { forward-clicked(); }
                            }
                        }
                        Rectangle {
                            height: 28px;
                            background: active-nav == drive ? #252525 : (parent.has-hover ? #222222 : #161616);
                            border-radius: 5px;
                            
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: start;
                                
                                Text {
                                    text: drive;
                                    color: active-nav == drive ? #ffffff : #aaaaaa;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    
                    // Spacer between Drives and Tags
                    Rectangle { height: 10px; }
                    
                    // TAGS Section
                    Text {
                        text: "TAGS";
                        color: #555555;
                        font-size: 10px;
                        font-weight: 700;
                    }
                    
                    // Tag Pills
                    HorizontalLayout {
                        spacing: 6px;
                        
                        TouchArea {
                            clicked => {
                                if (active-tag-filter == "Work") {
                                    active-tag-filter = "";
                                } else {
                                    active-tag-filter = "Work";
                                }
                                tag-filter-clicked();
                            }
                            Rectangle {
                                background: active-tag-filter == "Work" ? #1e1b2e : #252525;
                                border-color: active-tag-filter == "Work" ? #534ab7 : #333333;
                                border-width: 1px;
                                border-radius: 10px;
                                height: 20px;
                                
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    Text {
                                        text: "Work";
                                        color: active-tag-filter == "Work" ? #afa9ec : #888888;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        
                        TouchArea {
                            clicked => {
                                if (active-tag-filter == "Personal") {
                                    active-tag-filter = "";
                                } else {
                                    active-tag-filter = "Personal";
                                }
                                tag-filter-clicked();
                            }
                            Rectangle {
                                background: active-tag-filter == "Personal" ? #1e1b2e : #252525;
                                border-color: active-tag-filter == "Personal" ? #534ab7 : #333333;
                                border-width: 1px;
                                border-radius: 10px;
                                height: 20px;
                                
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    Text {
                                        text: "Personal";
                                        color: active-tag-filter == "Personal" ? #afa9ec : #888888;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    
                    HorizontalLayout {
                        spacing: 6px;
                        
                        TouchArea {
                            clicked => {
                                if (active-tag-filter == "Archive") {
                                    active-tag-filter = "";
                                } else {
                                    active-tag-filter = "Archive";
                                }
                                tag-filter-clicked();
                            }
                            Rectangle {
                                background: active-tag-filter == "Archive" ? #1e1b2e : #252525;
                                border-color: active-tag-filter == "Archive" ? #534ab7 : #333333;
                                border-width: 1px;
                                border-radius: 10px;
                                height: 20px;
                                
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    Text {
                                        text: "Archive";
                                        color: active-tag-filter == "Archive" ? #afa9ec : #888888;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        
                        TouchArea {
                            clicked => {
                                if (active-tag-filter == "Receipts") {
                                    active-tag-filter = "";
                                } else {
                                    active-tag-filter = "Receipts";
                                }
                                tag-filter-clicked();
                            }
                            Rectangle {
                                background: active-tag-filter == "Receipts" ? #1e1b2e : #252525;
                                border-color: active-tag-filter == "Receipts" ? #534ab7 : #333333;
                                border-width: 1px;
                                border-radius: 10px;
                                height: 20px;
                                
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    Text {
                                        text: "Receipts";
                                        color: active-tag-filter == "Receipts" ? #afa9ec : #888888;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            
            // Main File Area (fills remaining space, #1a1a1a bg)
            Rectangle {
                background: #1a1a1a;
                
                if (show-homepage) : VerticalLayout {
                    alignment: center;
                    spacing: 0;
                    
                    VerticalLayout {
                        alignment: center;
                        spacing: 0;
                        
                        // Centered content
                        HorizontalLayout {
                            alignment: center;
                            Text {
                                text: "hi there, " + username;
                                color: #dddddd;
                                font-size: 28px;
                                font-weight: 500;
                                horizontal-alignment: center;
                            }
                        }
                        
                        Rectangle { height: 4px; }
                        
                        HorizontalLayout {
                            alignment: center;
                            Text {
                                text: "what are you looking for?";
                                color: #555555;
                                font-size: 16px;
                                horizontal-alignment: center;
                            }
                        }
                        
                        Rectangle { height: 24px; }
                        
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                background: #252525;
                                border-color: #333333;
                                border-width: 0.5px;
                                border-radius: 10px;
                                height: 44px;
                                width: 500px;
                                
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    
                                    TextInput {
                                        font-size: 14px;
                                        color: #cccccc;
                                        vertical-alignment: center;
                                        accepted => {
                                            search-query(self.text);
                                            show-homepage = false;
                                        }
                                        
                                        if (self.text == "") : Text {
                                            text: "describe a file...";
                                            color: #555555;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                
                if (!show-homepage) : VerticalLayout {
                    // Breadcrumb bar
                    Rectangle {
                        height: 28px;
                        
                        // Bottom border line
                        Rectangle {
                            height: 1px;
                            y: parent.height - 1px;
                            background: #222222;
                        }
                        
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 15px;
                            alignment: start;
                            spacing: 12px;
                            
                            // Back Button
                            TouchArea {
                                width: 60px;
                                height: 28px;
                                clicked => {
                                    if (can-go-back) {
                                        back-clicked();
                                    }
                                }
                                Rectangle {
                                    background: parent.has-hover && can-go-back ? #333333 : #252525;
                                    border-color: #333333;
                                    border-width: 0.5px;
                                    border-radius: 6px;
                                    opacity: can-go-back ? 1.0 : 0.3;
                                    
                                    Text {
                                        text: "← back";
                                        color: #aaaaaa;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            
                            // Forward Button
                            TouchArea {
                                width: 60px;
                                height: 28px;
                                clicked => {
                                    if (can-go-forward) {
                                        forward-clicked();
                                    }
                                }
                                Rectangle {
                                    background: parent.has-hover && can-go-forward ? #333333 : #252525;
                                    border-color: #333333;
                                    border-width: 0.5px;
                                    border-radius: 6px;
                                    opacity: can-go-forward ? 1.0 : 0.3;
                                    
                                    Text {
                                        text: "forward →";
                                        color: #aaaaaa;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            
                            Text {
                                text: current-path;
                                color: #888888;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            
                            if (active-tag-filter != "") : Text {
                                text: "  •  filtering by: #" + active-tag-filter;
                                color: #9c8ff9;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                    
                    // ListView of files
                    ListView {
                        for file in files : TouchArea {
                            height: 52px; // slightly taller for stacked tags
                            clicked => {
                                file-clicked(file.path);
                            }
                            double-clicked => {
                                if (file.is-dir) {
                                    folder-clicked(file.path);
                                } else {
                                    file-double-clicked(file.path);
                                }
                            }
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.back && event.kind == PointerEventKind.down) {
                                    if (can-go-back) { back-clicked(); }
                                }
                                if (event.button == PointerEventButton.forward && event.kind == PointerEventKind.down) {
                                    if (can-go-forward) { forward-clicked(); }
                                }
                            }
                            
                             Rectangle {
                                background: parent.has-hover ? #222222 : #1a1a1a;
                                
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    padding-top: 6px;
                                    padding-bottom: 6px;
                                    spacing: 12px;
                                    
                                    // Icon (28x28 rounded rect)
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        background: file.is-dir ? #1e1e14 : #1a1e2a;
                                        border-radius: 6px;
                                        
                                        // Folder/File placeholder color inside
                                        Rectangle {
                                            width: 12px;
                                            height: 10px;
                                            background: file.is-dir ? #ef9f27 : #378add;
                                            border-radius: 2px;
                                        }
                                    }
                                    
                                    // Filename, description, and tags
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        
                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;
                                            
                                            Text {
                                                text: file.name;
                                                color: #ffffff;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                            }
                                        }
                                        
                                        // Tags list below filename
                                        if (file.tags.length > 0) : HorizontalLayout {
                                            spacing: 4px;
                                            alignment: start;
                                            
                                            for t in file.tags : Rectangle {
                                                background: #1e1b2e;
                                                border-color: #534ab7;
                                                border-width: 1px;
                                                border-radius: 4px;
                                                height: 16px;
                                                
                                                HorizontalLayout {
                                                    padding-left: 4px;
                                                    padding-right: 4px;
                                                    alignment: center;
                                                    Text {
                                                        text: t;
                                                        color: #ffffff;
                                                        font-size: 10px;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                        
                                        Text {
                                            text: file.description != "" ? file.description : "no description";
                                            color: file.description != "" ? #ffffff : #888888;
                                            font-size: 11px;
                                            font-italic: file.description == "";
                                        }
                                    }
                                    
                                    // Spacer
                                    Rectangle {}
                                    
                                    // File size
                                    Text {
                                        text: file.size;
                                        color: #ffffff;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            
            // Right Detail Panel (240px, #161616 bg, #2a2a2a left border)
            Rectangle {
                width: 240px;
                background: #161616;
                
                // Left border line
                Rectangle {
                    width: 1px;
                    x: 0;
                    background: #2a2a2a;
                }
                
                if (!show-detail) : Text {
                    text: "No file selected";
                    color: #ffffff;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                
                if (show-detail) : VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: start;
                    
                    // File name and path
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: selected-file-name;
                            color: #ffffff;
                            font-size: 14px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        Text {
                            text: selected-file-path;
                            color: #ffffff;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                    }
                    
                    // 14px gap before sections
                    Rectangle { height: 14px; }
                    
                    // "DESCRIPTION" label
                    Text {
                        text: "DESCRIPTION";
                        color: #ffffff;
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 0.8px;
                    }
                    
                    // Description input
                    Rectangle {
                        background: #1e1e1e;
                        border-color: #333333;
                        border-width: 0.5px;
                        border-radius: 8px;
                        height: 80px;
                        
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            
                            desc-input := TextInput {
                                text <=> selected-file-description;
                                font-size: 12px;
                                color: #ffffff;
                                wrap: word-wrap;
                                single-line: false;
                                accepted => {
                                    save-file(selected-file-path, selected-file-description, current-tags);
                                }
                                changed has-focus => {
                                    if (self.has-focus && selected-file-description == "" && description-suggestion != "") {
                                        selected-file-description = description-suggestion;
                                    }
                                    if (!self.has-focus) {
                                        save-file(selected-file-path, selected-file-description, current-tags);
                                    }
                                }
                                edited => {
                                    description-edited(self.text);
                                }
                            }
                            
                            if (selected-file-description == "" && !desc-input.has-focus) : Text {
                                text: description-suggestion;
                                color: #444444;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    
                    // "TAGS" label
                    Text {
                        text: "TAGS";
                        color: #ffffff;
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 0.8px;
                    }
                    
                    // Tags pills display
                    if (selected-file-tags-list.length > 0) : HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for tag in selected-file-tags-list : Rectangle {
                            background: #1e1b2e;
                            border-color: #534ab7;
                            border-width: 1px;
                            border-radius: 10px;
                            height: 20px;
                            
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: center;
                                spacing: 4px;
                                
                                Text {
                                    text: tag;
                                    color: #ffffff;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                
                                TouchArea {
                                    width: 12px;
                                    height: 12px;
                                    clicked => {
                                        remove-tag(tag);
                                    }
                                    Text {
                                        text: "×";
                                        color: #aaaaaa;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    
                    // + add tag capsule button or inline TextInput
                    if (!show-tag-input) : TouchArea {
                        clicked => {
                            show-tag-input = true;
                        }
                        Rectangle {
                            height: 28px;
                            background: #1e1e1e;
                            border-color: #333333;
                            border-width: 1px;
                            border-radius: 14px;
                            
                            Text {
                                text: "+ add tag";
                                color: #ffffff;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    
                    if (show-tag-input) : Rectangle {
                        height: 28px;
                        background: #1e1e1e;
                        border-color: #333333;
                        border-width: 1px;
                        border-radius: 14px;
                        
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            
                            TextInput {
                                font-size: 11px;
                                color: #ffffff;
                                vertical-alignment: center;
                                accepted => {
                                    if (self.text != "") {
                                        add-tag(self.text);
                                        self.text = "";
                                    }
                                    show-tag-input = false;
                                }
                                changed has-focus => {
                                    if (!self.has-focus) {
                                        if (self.text != "") {
                                            add-tag(self.text);
                                            self.text = "";
                                        }
                                        show-tag-input = false;
                                    }
                                }
                            }
                        }
                    }
                    
                    // Spacer
                    Rectangle {}
                    
                    // Manual save button removed to support auto-saving on focus-loss / enter
                }
            }
        }
        
        // 3. Statusbar (22px, #111111, top border #222222)
        Rectangle {
            height: 22px;
            background: #111111;
            
            // Top border line
            Rectangle {
                height: 1px;
                y: 0;
                background: #222222;
            }
            
            HorizontalLayout {
                padding-left: 15px;
                padding-right: 15px;
                alignment: start;
                
                Text {
                    text: status-text;
                    color: #555555;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
    }
    }
    }
}
